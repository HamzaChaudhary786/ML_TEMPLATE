# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# C extensions & distribution / packaging
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
# ==========================================
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Jupyter Notebooks & Caches
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Unit test / coverage reporting
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ==========================================
# Logs & Temporary files
# ==========================================
logs/*.log
*.log
tmp/
scratch/

# ==========================================
# Large Datasets (Keep folder structure via .gitkeep)
# ==========================================
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# ==========================================
# Trained Models & Serialized Artifacts
# ==========================================
models/*
!models/.gitkeep
artifacts/*
!artifacts/.gitkeep

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# IDE / Editor configuration
# ==========================================
.idea/
.vscode/
*.swp
*.swo
